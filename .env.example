# ANF EasyTier 统一配置模板
#
# 用法：复制本文件为仓库根目录 .env，然后按需修改。
#   - .env 已被 .gitignore 覆盖，绝不会入库；
#   - 脚本（scripts/*.ps1|.py|.sh）自动读取根目录 .env；
#   - easytier-web 启动时自动加载根目录 .env，并把 ANF_* 映射为 ET_ANF_*；
#   - docker compose 用 --env-file .env 读取同一份文件。
#
# 安全提示：不要在这里填任何"与仓库绑定"的真实生产默认值；
# 生产环境请使用强随机口令/密钥，并通过部署平台注入。

# ---- ANF 中心网络（easytier-web 与中心 core 必须使用同一网络名/密钥）----
# 启动时自动映射为 ET_ANF_NETWORK_NAME / ET_ANF_NETWORK_SECRET / ET_ANF_CENTER_PEER_URL
ANF_NETWORK_NAME=anf-m3
ANF_NETWORK_SECRET=change-me
ANF_CENTER_PEER_URL=tcp://127.0.0.1:11110

# ---- 服务地址（供 scripts/*.ps1|.py|.sh 使用）----
# 单机/本地部署用 127.0.0.1；跨主机时改成实际可达地址
ANF_WEB_BASE=http://127.0.0.1:11211
ANF_CONFIG_SERVER=udp://127.0.0.1:22020/admin

# ---- 管理员账号（easytier-web admin-bind 首次引导与脚本登录共用）----
ANF_ADMIN_USER=admin
ANF_ADMIN_PASSWORD=change-me

# ---- 两步验证主密钥（可选，TOTP 2FA）----
# 用于加密 users.totp_secret_encrypted；设为任意强随机字符串即可。
# 留空时服务端会在 DB 同目录自动生成 <db>.totp_key 密钥文件（备份 DB 时勿单独泄露两者之一）。
ANF_TOTP_SECRET_KEY=

# ---- VM SSH（scripts/vm_ssh.py / vm_sftp.py；留空则脚本报错，不提供默认值）----
ANF_VM_HOST=
ANF_VM_PORT=22
ANF_VM_USER=anf-et
ANF_VM_PASSWORD=
ANF_VM_SUDO_PASSWORD=
# 本机 etgame（EasyTier mesh）网卡当前 IP；重启后可能漂移，需用 ipconfig 复查
ANF_VM_SSH_BIND=
ANF_VM_KEY2=

# ---- 镜像（deploy/compose.yaml 与 compose.anf.yaml）----
WEB_IMAGE=
CORE_IMAGE=

# ---- Gitea（可选：CI 推送/下载产物用 token，本地勿提交）----
GITEA_TOKEN=
ANF_VM_SSH_KEY=
