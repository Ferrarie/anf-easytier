# ANFAGENT-30 部署环境变量（M3 使用；实际 .env 不入库）
WEB_IMAGE=registry.example.com/anidev/anf-easytier-web-embed:v2.6.4-anf.0
CORE_IMAGE=registry.example.com/anidev/anf-easytier-core:v2.6.4-anf.0

# ANF 中心 mesh：web 与中心 core 必须使用同一网络名/密钥
ANF_NETWORK_NAME=anf-m3
ANF_NETWORK_SECRET=change-me
ANF_CENTER_PEER_URL=tcp://10.0.0.6:11110
