# ANF EasyTier 部署环境变量（docker compose 使用）
# 完整模板与说明见仓库根目录 .env.example；本文件仅为 compose 子集。
#
# 用法（在仓库根目录）：
#   cp .env.example .env            # 编辑根 .env
#   docker compose --env-file .env -f deploy/compose.anf.yaml up -d
WEB_IMAGE=
CORE_IMAGE=

# ANF 中心 mesh：web 与中心 core 必须使用同一网络名/密钥
ANF_NETWORK_NAME=anf-m3
ANF_NETWORK_SECRET=change-me
ANF_CENTER_PEER_URL=tcp://127.0.0.1:11110
